# Core server
PORT=3333
NODE_ENV=production
CORS_ORIGIN=https://itassetregister.yourdomain.local
POSTGRES_URL=postgres://itadmin:CHANGEME@localhost:5432/itassetregisterdb
AUTH_SECRET=your-nextauth-auth-secret-here

# Tickets (email ingest + Microsoft Graph + SharePoint attachments)
TICKET_INGEST_API_KEY=
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
SUPPORT_EMAIL=it.support@mastertech.ie
APP_BASE_URL=https://itassetregister.yourdomain.local
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=

# H&S SharePoint (Phase 3) - set all five IDs or none (D-24); see docs/design/hs-phase3-runbook.md Part C
# None set: the server boots and H&S routes answer 503 HS_NOT_CONFIGURED.
# One to four set: the server refuses to start.
HS_ME_SITE_ID=
HS_ME_DRIVE_ID=
HS_QHSE_SITE_ID=
HS_QHSE_PREAPPROVED_DRIVE_ID=
HS_QHSE_CONTROL_DRIVE_ID=
# Optional path overrides (defaults shown)
# HS_ME_PROJECTS_ROOT=01_Proj/Open
# HS_ME_PROJECT_HS_PATH=1. Cons/5. H&S
# HS_ME_PERMITS_FOLDER=Permits
# HS_QHSE_PREAPPROVED_ROOT=
# HS_QHSE_CONTROL_ROOT=
